# Configuracion de docker compose. Copie este archivo como .env (en esta misma carpeta) y complete los valores.

# ---------------------------------------------------------------- obligatorias
DB_PASSWORD=
# Minimo 32 caracteres. Genere uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------------------------------------------------------------- base de datos y zona horaria
DB_NAME=tienda_db
TZ=America/La_Paz

# ---------------------------------------------------------------- direccion de la aplicacion
# Puertos publicados en su equipo. Si cambia WEB_PORT, ajuste las dos direcciones de abajo
WEB_PORT=80
MAIL_UI_PORT=8025
FRONTEND_URL_RESTABLECER=http://localhost/restablecer
CORS_ORIGENES=http://localhost

# ---------------------------------------------------------------- correo
# Por defecto, el servidor de pruebas incluido (Mailpit). Para uno real cambie estos valores
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# ---------------------------------------------------------------- datos de ejemplo (opcional)
# Siembra datos en una base vacia. Si lo activa, no lo quite mientras use esa base
# SPRING_PROFILES_ACTIVE=seed
