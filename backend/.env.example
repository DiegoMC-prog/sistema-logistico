# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tienda_db_r2
DB_USER=postgres
DB_PASSWORD=

# Servidor de correo: Mailtrap sandbox (pruebas) o Mailpit/MailHog local (localhost:1025, sin autenticacion)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# true si el servidor exige usuario y contrasena (Mailtrap); false para Mailpit/MailHog
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Configuración de sesión / cookies / seguridad (opcional para desarrollo)
SERVER_PORT=8080

# Seguridad JWT. JWT_SECRET es obligatorio (minimo 32 bytes). Genere uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7

# Lista de tokens revocados: memoria (una sola instancia) | redis
# Para redis: docker run -d --name redis -p 6379:6379 redis:7
APP_REVOCACION=memoria
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Pantalla del frontend para elegir la contrasena nueva (el correo de "olvide mi contrasena" enlaza a ella con ?token=...)
FRONTEND_URL_RESTABLECER=http://localhost:4200/restablecer

# Origenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGENES=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Perfil de Spring: "seed" siembra datos de desarrollo en una base vacia (db/seed). Dejelo comentado en produccion.
# SPRING_PROFILES_ACTIVE=seed
